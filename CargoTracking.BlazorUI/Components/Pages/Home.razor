@page "/"
@using CargoTracking.Grpc
@inject CargoApiClient Api
@inject UiStateService UiState
@inject NavigationManager Nav

<PageTitle>KARGO PRO | Ana Sayfa</PageTitle>

<div class="kp-dashboard">
    <!-- ÜST BANNER -->
    <div class="kp-hero-banner">
        <div>
            <span class="kp-hero-tag">MERKEZİ LOJİSTİK KOMUTA PANELİ</span>
            <h2>Ulusal Dağıtım ve Canlı Filo Yönetim Merkezi</h2>
            <p>Tüm şube çıkışlarını, sahadaki aktif kurye rotalarını ve teslimat performansını gerçek zamanlı denetleyin.</p>
        </div>
        <div class="kp-hero-actions">
            <button type="button" class="kp-btn kp-btn-primary" @onclick='() => Nav.NavigateTo("/yeni")'>
                + Yeni Sevkiyat Oluştur
            </button>
            <button type="button" class="kp-btn kp-btn-outline" @onclick='() => Nav.NavigateTo("/canli")'>
                Canlı Haritayı Aç
            </button>
        </div>
    </div>

    <!-- 4'LÜ KURUMSAL KPI KARTLARI -->
    <div class="kp-kpi-grid">
        <div class="kp-kpi-card kpi-blue" @onclick='() => Nav.NavigateTo("/liste/ALL")'>
            <div class="kp-kpi-top">
                <span>TOPLAM SEVKİYAT HACMİ</span>
                <div class="kp-kpi-icon">📦</div>
            </div>
            <div class="kp-kpi-value">@_totalCount</div>
            <div class="kp-kpi-bar"><div style="width: 100%; background:#3b82f6;"></div></div>
            <div class="kp-kpi-foot">Tüm kayıtları incelemek için tıklayın →</div>
        </div>

        <div class="kp-kpi-card kpi-emerald" @onclick='() => Nav.NavigateTo("/liste/ACTIVE")'>
            <div class="kp-kpi-top">
                <span>AKTİF OPERASYONDAKİLER</span>
                <div class="kp-kpi-icon">⚡</div>
            </div>
            <div class="kp-kpi-value">@_activeCount</div>
            <div class="kp-kpi-bar"><div style="width: @(GetPercentage(_activeCount))%; background:#10b981;"></div></div>
            <div class="kp-kpi-foot">Operasyon oranı: %@GetPercentage(_activeCount) →</div>
        </div>

        <div class="kp-kpi-card kpi-cyan" @onclick='() => Nav.NavigateTo("/canli")'>
            <div class="kp-kpi-top">
                <span>SAHADA YOLA ÇIKAN (CANLI)</span>
                <div class="kp-kpi-icon">🚚</div>
            </div>
            <div class="kp-kpi-value">@_inTransitCount</div>
            <div class="kp-kpi-bar"><div style="width: @(GetPercentage(_inTransitCount))%; background:#06b6d4;"></div></div>
            <div class="kp-kpi-foot">Canlı GPS radarına bağlan →</div>
        </div>

        <div class="kp-kpi-card kpi-slate" @onclick='() => Nav.NavigateTo("/liste/PASSIVE")'>
            <div class="kp-kpi-top">
                <span>TAMAMLANAN / ARŞİV</span>
                <div class="kp-kpi-icon">✓</div>
            </div>
            <div class="kp-kpi-value">@_passiveCount</div>
            <div class="kp-kpi-bar"><div style="width: @(GetPercentage(_passiveCount))%; background:#64748b;"></div></div>
            <div class="kp-kpi-foot">Tamamlanma oranı: %@GetPercentage(_passiveCount) →</div>
        </div>
    </div>

    <!-- ALT İKİLİ KURUMSAL PANELLER -->
    <div class="kp-dash-split">
        <!-- SOL: SON SEVKIYAT HAREKETLERİ TABLOSU -->
        <div class="kp-card">
            <div class="kp-card-header">
                <div>
                    <h3>Son Kaydedilen Sevkiyat Hareketleri</h3>
                    <p>Sistemdeki son 5 kargo kaydının anlık operasyon özeti</p>
                </div>
                <button type="button" class="kp-link-btn" @onclick='() => Nav.NavigateTo("/liste/ALL")'>
                    Tümünü Gör →
                </button>
            </div>
            <div class="kp-table-box">
                <table class="kp-table">
                    <thead>
                        <tr>
                            <th>Takip Kodu</th>
                            <th>Gönderici / Alıcı</th>
                            <th>Teslimat Bölgesi</th>
                            <th>Statü</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _cargos.TakeLast(5).Reverse())
                        {
                            <tr @onclick='() => Nav.NavigateTo($"/sorgula/{item.TrackingNumber.Replace("TR-", "")}")'>
                                <td><strong class="kp-mono">@item.TrackingNumber</strong></td>
                                <td>@item.SenderName → @item.ReceiverName</td>
                                <td>@item.LastLocation</td>
                                <td><StatusBadge Status="@item.CurrentStatus" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- SAĞ: SAHADAKİ CANLI KURYE FİLOSU -->
        <div class="kp-card">
            <div class="kp-card-header">
                <div>
                    <h3>Canlı Dağıtım Filosu (Yoldakiler)</h3>
                    <p>Şu anda sahada hareket halinde olan aktif kuryeler</p>
                </div>
            </div>
            <div class="kp-fleet-list">
                @if (!_cargos.Any(c => c.CurrentStatus == "Yola Çıktı"))
                {
                    <div class="kp-empty-state">
                        Şu anda "Yola Çıktı" statüsünde sahada kurye bulunmuyor. Sorgula ve Düzenle ekranından bir kargoyu yola çıkarabilirsiniz.
                    </div>
                }
                else
                {
                    @foreach (var activeItem in _cargos.Where(c => c.CurrentStatus == "Yola Çıktı"))
                    {
                        <div class="kp-fleet-item">
                            <div class="kp-fleet-info">
                                <div class="kp-fleet-code">
                                    <span class="kp-pulse-dot"></span>
                                    <strong>@activeItem.TrackingNumber</strong>
                                </div>
                                <div class="kp-fleet-route">@activeItem.LastLocation</div>
                                <div class="kp-fleet-rec">Alıcı: @activeItem.ReceiverName</div>
                            </div>
                            <button type="button" class="kp-btn kp-btn-sm kp-btn-primary" @onclick='() => Nav.NavigateTo($"/canli/{activeItem.TrackingNumber.Replace("TR-", "")}")'>
                                Haritada İzle →
                            </button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<CargoStatusResponse> _cargos = new();
    private int _totalCount;
    private int _activeCount;
    private int _passiveCount;
    private int _inTransitCount;

    protected override async Task OnInitializedAsync()
    {
        UiState.SetBreadcrumb("Operasyon Merkezi  /  Ana Sayfa");
        await RefreshDashboardAsync();
    }

    private async Task RefreshDashboardAsync()
    {
        _cargos = await Api.GetAllCargosSafeAsync();
        _totalCount = _cargos.Count;
        _activeCount = _cargos.Count(c => c.IsActive);
        _passiveCount = _cargos.Count(c => !c.IsActive);
        _inTransitCount = _cargos.Count(c => c.CurrentStatus == "Yola Çıktı");

        UiState.UpdateMetrics(_inTransitCount, Api.IsServerOnline);
    }

    private int GetPercentage(int part) => _totalCount == 0 ? 0 : (int)Math.Round((double)part / _totalCount * 100);
}