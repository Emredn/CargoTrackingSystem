@page "/"
@rendermode InteractiveServer
@using CargoTracking.Grpc
@using System.Globalization
@using System.Text
@using System.Text.Json
@using System.Threading
@implements IDisposable
@inject IJSRuntime JSRuntime

<PageTitle>KARGO PRO | Kurumsal Lojistik ve Operasyon Yönetim Sistemi</PageTitle>

<div class="app-wrapper">
    <!-- SOL YAN MENÜ (SIDEBAR) -->
    <aside class="sidebar no-print">
        <div class="brand-header">
            <h1>KARGO PRO</h1>
            <p>Tek Merkez, Sıfır Kayıp,<br />Kesintisiz Lojistik Takip</p>
        </div>

        <nav class="nav-list">
            <button type="button" class="nav-btn @(_activePage == "HOME" ? "active" : "")" @onclick='() => NavigateTo("HOME", "Operasyon Merkezi  >  Ana Sayfa")'>
                ANA SAYFA
            </button>
            <button type="button" class="nav-btn @(_activePage == "ADD" ? "active" : "")" @onclick='() => NavigateTo("ADD", "Operasyon Merkezi  >  Yeni Kargo Kaydı")'>
                YENİ KARGO KAYDI
            </button>
            <button type="button" class="nav-btn @(_activePage == "QUERY" ? "active" : "")" @onclick='() => { ResetQueryScreen(); NavigateTo("QUERY", "Operasyon Merkezi  >  Kargo Sorgula ve Düzenle"); }'>
                SORGULA VE DÜZENLE
            </button>
            <button type="button" class="nav-btn @(_activePage == "LIST" ? "active" : "")" @onclick='async () => { NavigateTo("LIST", "Operasyon Merkezi  >  Kargo Listeleri  >  Tüm Kargolar"); await LoadCargoListAsync("ALL"); }'>
                KARGO LİSTELERİ
            </button>
            <button type="button" class="nav-btn @(_activePage == "LIVE_MAP" ? "active" : "")" @onclick='() => { StopLiveTracking(clearMessage: true); NavigateTo("LIVE_MAP", "Operasyon Merkezi  >  Canlı Kurye ve Harita Takibi"); }'>
                CANLI KARGO TAKİBİ
            </button>
        </nav>

        <div class="sidebar-footer">
            Kurumsal Operasyon Ağı v2.4<br />Yeni Nesil Dağıtık Kargo Mimarisi
        </div>
    </aside>

    <!-- SAĞ ANA BÖLGE -->
    <div class="main-area">
        <!-- ÜST BAR -->
        <header class="top-header no-print">
            <div class="header-left">
                <button type="button" class="btn-back" disabled="@(_navHistory.Count == 0)" @onclick="GoBackAsync">
                    &lt; Geri Dön
                </button>
                <span class="breadcrumb-text">@_breadcrumb</span>
            </div>
            <div class="header-right">
                <span class="server-badge @(_serverOnline ? "online" : "offline")">
                    ● gRPC Sunucu: @(_serverOnline ? "Aktif (5135)" : "Bağlantı Yok")
                </span>
                <span class="live-clock">@_clockText</span>
            </div>
        </header>

        <!-- İÇERİK EKRANLARI -->
        <main class="page-content">

            <!-- 1. SAYFA: ANA SAYFA -->
            @if (_activePage == "HOME")
            {
                <div class="page-section">
                    <h2 class="page-title">Operasyon Kontrol Merkezi</h2>
                    <p class="page-subtitle">İlgili kargo listesini doğrudan görüntülemek için aşağıdaki özet kartların üzerine tıklayabilirsiniz.</p>

                    <div class="summary-cards">
                        <div class="summary-card card-blue" @onclick='async () => { NavigateTo("LIST", "Operasyon Merkezi  >  Kargo Listeleri  >  Tüm Kargolar"); await LoadCargoListAsync("ALL"); }'>
                            <div class="sc-title">TÜM KAYITLI KARGOLAR</div>
                            <div class="sc-count">@_totalCount</div>
                            <div class="sc-link">Tüm listeyi açmak için tıklayın &gt;</div>
                        </div>

                        <div class="summary-card card-green" @onclick='async () => { NavigateTo("LIST", "Operasyon Merkezi  >  Kargo Listeleri  >  Aktif Kargolar"); await LoadCargoListAsync("ACTIVE"); }'>
                            <div class="sc-title">AKTİF (OPERASYONDAKİ) KARGOLAR</div>
                            <div class="sc-count">@_activeCount</div>
                            <div class="sc-link">Sadece aktif kargoları görmek için tıklayın &gt;</div>
                        </div>

                        <div class="summary-card card-slate" @onclick='async () => { NavigateTo("LIST", "Operasyon Merkezi  >  Kargo Listeleri  >  Pasif (Arşiv)"); await LoadCargoListAsync("PASSIVE"); }'>
                            <div class="sc-title">PASİF (ARŞİVLENMİŞ) KARGOLAR</div>
                            <div class="sc-count">@_passiveCount</div>
                            <div class="sc-link">Teslim ve iptal kayıtları için tıklayın &gt;</div>
                        </div>
                    </div>

                    <div class="slogan-box">
                        <h3>"Hız, Güven ve Tam İzlenebilirlik: Tüm Kargo Operasyonunuz Tek Çatı Altında."</h3>
                        <p>KARGO PRO altyapısı ile şubeler arası gönderi takibini gerçek zamanlı yönetin, geçmişe dönük arşiv kayıtlarını sıfır veri kaybıyla denetleyin.</p>
                    </div>
                </div>
            }

            <!-- 2. SAYFA: YENİ KARGO KAYDI -->
            @if (_activePage == "ADD")
            {
                <div class="page-section">
                    <h2 class="page-title">Yeni Kargo Gönderimi Oluştur</h2>

                    <div class="panel-card" style="max-width: 620px;">
                        @if (!string.IsNullOrEmpty(_addFeedback))
                        {
                            <div class="alert-box @(_addSuccess ? "alert-ok" : "alert-err")">@_addFeedback</div>
                        }

                        <div class="grid-2col">
                            <div class="field-group">
                                <label>Gönderici Adı Soyadı / Kurum:</label>
                                <input type="text" class="text-input" @bind="_newSender" />
                            </div>

                            <div class="field-group">
                                <label>Alıcı Adı Soyadı:</label>
                                <input type="text" class="text-input" @bind="_newReceiver" />
                            </div>
                        </div>

                        <div class="grid-2col">
                            <div class="field-group">
                                <label>Teslimat İli:</label>
                                <select class="text-input" value="@_newCity" @onchange="OnNewCityChanged">
                                    <option value="">-- İl Seçiniz --</option>
                                    @foreach (var prov in _provinces)
                                    {
                                        <option value="@prov.Name">@prov.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="field-group">
                                <label>Teslimat İlçesi:</label>
                                <select class="text-input" @bind="_newDistrict" disabled="@(string.IsNullOrEmpty(_newCity))">
                                    <option value="">-- İlçe Seçiniz --</option>
                                    @foreach (var dist in GetDistrictsForCity(_newCity))
                                    {
                                        <option value="@dist">@dist</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="field-group">
                            <label>Mahalle, Cadde, Sokak ve Bina/Kapı No:</label>
                            <input type="text" class="text-input" @bind="_newStreetDetail" />
                        </div>

                        <div class="field-group">
                            <label>Tahmini Teslim Tarihi (Geçmiş Tarih Seçilemez):</label>
                            <input type="date" class="text-input" @bind="_newDeliveryDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>

                        <button type="button" class="btn-action btn-green" @onclick="CreateCargoAsync">
                            KARGOYU SİSTEME KAYDET
                        </button>
                    </div>
                </div>
            }

            <!-- 3. SAYFA: SORGULA VE DÜZENLE -->
            @if (_activePage == "QUERY")
            {
                <div class="page-section">
                    <h2 class="page-title">Kargo Sorgulama ve Kayıt Düzenleme</h2>

                    <div class="panel-card" style="max-width: 740px; margin-bottom: 20px;">
                        <label class="small-label">4 Haneli Kargo Takip Kodunu Girin (Sadece Rakam, Enter ile Sorgular):</label>
                        <div class="query-bar">
                            <span class="tr-prefix">TR -</span>
                            <input type="text"
                                   class="code-box"
                                   maxlength="4"
                                   value="@_trackingDigits"
                                   @oninput="OnTrackingCodeInput"
                                   @onkeydown="OnTrackingCodeKeyDown" />
                            <button type="button" class="btn-action btn-blue" style="width:auto; padding: 0 28px;" @onclick="SearchCargoByCodeAsync">
                                KAYDI SORGULA
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(_queryFeedback))
                        {
                            <div class="alert-box @(_querySuccess ? "alert-ok" : "alert-err")" style="margin-top:14px;">@_queryFeedback</div>
                        }
                    </div>

                    @if (_showDetailEditCard)
                    {
                        <div class="panel-card" style="max-width: 740px;">
                            <div class="edit-header-strip">
                                Takip Numarası: @_editTrackingNo &nbsp;&nbsp;|&nbsp;&nbsp; Kayıt Statüsü: @(_editIsActive ? "AKTİF KAYIT" : "PASİF (ARŞİVLENMİŞ) KAYIT")
                            </div>

                            <div class="grid-2col">
                                <div class="field-group">
                                    <label>Gönderici Adı Soyadı:</label>
                                    <input type="text" class="text-input" @bind="_editSender" />
                                </div>
                                <div class="field-group">
                                    <label>Alıcı Adı Soyadı:</label>
                                    <input type="text" class="text-input" @bind="_editReceiver" />
                                </div>
                            </div>

                            <div class="grid-2col">
                                <div class="field-group">
                                    <label>Teslimat İli:</label>
                                    <select class="text-input" value="@_editCity" @onchange="OnEditCityChanged">
                                        <option value="">-- İl Seçiniz --</option>
                                        @foreach (var prov in _provinces)
                                        {
                                            <option value="@prov.Name">@prov.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="field-group">
                                    <label>Teslimat İlçesi:</label>
                                    <select class="text-input" @bind="_editDistrict" disabled="@(string.IsNullOrEmpty(_editCity))">
                                        <option value="">-- İlçe Seçiniz --</option>
                                        @foreach (var dist in GetDistrictsForCity(_editCity))
                                        {
                                            <option value="@dist">@dist</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="field-group">
                                <label>Mahalle, Cadde, Sokak ve Kapı No:</label>
                                <input type="text" class="text-input" @bind="_editStreetDetail" />
                            </div>

                            <div class="grid-2col">
                                <div class="field-group">
                                    <label>Tahmini Teslim Tarihi:</label>
                                    <input type="date" class="text-input" @bind="_editDeliveryDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="field-group">
                                    <label>Operasyon Durumu:</label>
                                    <select class="text-input" @bind="_editStatus">
                                        <option value="Hazırlanıyor">Hazırlanıyor</option>
                                        <option value="Yola Çıktı">Yola Çıktı</option>
                                        <option value="Teslim Edildi">Teslim Edildi</option>
                                        <option value="İptal Edildi">İptal Edildi</option>
                                    </select>
                                </div>
                            </div>

                            <button type="button" class="btn-action btn-orange" @onclick="SaveEditedCargoAsync">
                                DEĞİŞİKLİKLERİ VE DURUMU KAYDET
                            </button>
                        </div>
                    }
                </div>
            }

            <!-- 4. SAYFA: KARGO LİSTELERİ -->
            @if (_activePage == "LIST")
            {
                <div class="page-section">
                    <h2 class="page-title">@_listHeaderTitle</h2>

                    <div class="filter-toolbar no-print">
                        <div class="tab-group">
                            <button type="button" class="filter-tab @(_currentFilter == "ALL" ? "active-tab" : "")" @onclick='() => LoadCargoListAsync("ALL")'>
                                TÜM KARGOLAR
                            </button>
                            <button type="button" class="filter-tab @(_currentFilter == "ACTIVE" ? "active-tab" : "")" @onclick='() => LoadCargoListAsync("ACTIVE")'>
                                AKTİF KARGOLAR
                            </button>
                            <button type="button" class="filter-tab @(_currentFilter == "PASSIVE" ? "active-tab" : "")" @onclick='() => LoadCargoListAsync("PASSIVE")'>
                                PASİF (ARŞİV)
                            </button>
                        </div>

                        <div class="export-actions">
                            <button type="button" class="btn-export btn-excel" @onclick="ExportFilteredListToExcelAsync" title="Excel formatında indir">
                                📊 Excel
                            </button>
                            <button type="button" class="btn-export btn-pdf" @onclick="ExportToPdfAsync" title="PDF olarak yazdır veya kaydet">
                                📄 PDF
                            </button>
                        </div>

                        <div class="live-search-box">
                            <label>🔎 Hızlı Ara:</label>
                            <input type="text" class="text-input" style="width:230px;" @bind="_liveSearch" @bind:event="oninput" placeholder="Takip no, il, ilçe..." />
                        </div>
                    </div>

                    <div class="list-split-layout">
                        <!-- SOL: TABLO -->
                        <div class="table-wrapper">
                            <table class="enterprise-table">
                                <thead>
                                    <tr>
                                        <th style="width: 95px;">Takip No</th>
                                        <th style="width: 140px;">Gönderici</th>
                                        <th style="width: 140px;">Alıcı</th>
                                        <th style="width: 125px;">Güncel Durum</th>
                                        <th>Teslimat Adresi (İl / İlçe - Detay)</th>
                                        <th style="width: 110px;">Teslim Tarihi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!FilteredCargos.Any())
                                    {
                                        <tr>
                                            <td colspan="6" style="text-align:center; padding: 30px; color:#64748b;">
                                                Bu filtreye uygun kargo kaydı bulunamadı.
                                            </td>
                                        </tr>
                                    }
                                    @foreach (var item in FilteredCargos)
                                    {
                                        <tr class="@GetRowColorClass(item.CurrentStatus) @(_selectedCargo?.TrackingNumber == item.TrackingNumber ? "selected-row" : "")"
                                            @onclick="() => SelectCargoForPreview(item)">
                                            <td><strong>@item.TrackingNumber</strong></td>
                                            <td>@item.SenderName</td>
                                            <td>@item.ReceiverName</td>
                                            <td><strong>@item.CurrentStatus</strong></td>
                                            <td>@item.LastLocation</td>
                                            <td>@item.EstimatedDelivery</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- SAĞ: ÖZET VE İŞLEM PANELİ -->
                        <div class="quick-preview-panel no-print">
                            <div class="qp-header">SEÇİLİ KARGO ÖZETİ</div>
                            @if (_selectedCargo != null)
                            {
                                <div class="qp-body">
                                    <div class="qp-trackno">@_selectedCargo.TrackingNumber</div>

                                    <button type="button" class="btn-copy @(_copiedJustNow ? "copied" : "")" @onclick="CopySelectedTrackNoAsync">
                                        @(_copiedJustNow ? "✓ PANOYA KOPYALANDI!" : "TAKİP NO KOPYALA")
                                    </button>

                                    <div class="qp-divider"></div>

                                    <div class="qp-item">
                                        <span>GÖNDERİCİ BİLGİSİ:</span>
                                        <strong>@_selectedCargo.SenderName</strong>
                                    </div>
                                    <div class="qp-item">
                                        <span>ALICI BİLGİSİ:</span>
                                        <strong>@_selectedCargo.ReceiverName</strong>
                                    </div>
                                    <div class="qp-item">
                                        <span>OPERASYON DURUMU:</span>
                                        <strong>@_selectedCargo.CurrentStatus</strong>
                                    </div>
                                    <div class="qp-item">
                                        <span>TESLİMAT ADRESİ:</span>
                                        <strong>@_selectedCargo.LastLocation</strong>
                                    </div>
                                    <div class="qp-item">
                                        <span>TAHMİNİ TESLİM TARİHİ:</span>
                                        <strong>@_selectedCargo.EstimatedDelivery</strong>
                                    </div>
                                    <div class="qp-item">
                                        <span>KAYIT STATÜSÜ:</span>
                                        <strong>@(_selectedCargo.IsActive ? "Aktif (Operasyonda)" : "Pasif (Arşivde)")</strong>
                                    </div>

                                    <button type="button" class="btn-action btn-orange" style="margin-top:auto;" @onclick="OpenSelectedCargoInEditAsync">
                                        BU KARGOYU DÜZENLE &gt;
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="qp-empty">
                                    Detayları görmek, takip numarasını kopyalamak veya düzenlemek için soldaki listeden bir kargoya tıklayın.
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- 5. SAYFA: CANLI HARİTA VE KURYE TAKİBİ -->
            @if (_activePage == "LIVE_MAP")
            {
                <div class="page-section">
                    <h2 class="page-title">Canlı Kurye ve Rota Takip Merkezi</h2>
                    <p class="page-subtitle">Yola çıkan tüm kargolar arka planda eşzamanlı ilerler. İstediğiniz kargo kodunu yazıp anlık konumuna bağlanabilirsiniz.</p>

                    <div class="panel-card" style="max-width: 800px; margin-bottom: 20px;">
                        <label class="small-label">4 Haneli Kargo Takip Kodunu Girin:</label>
                        <div class="query-bar">
                            <span class="tr-prefix">TR -</span>
                            <input type="text"
                                   class="code-box"
                                   maxlength="4"
                                   value="@_liveMapDigits"
                                   @oninput="OnLiveMapInput"
                                   @onkeydown="OnLiveMapKeyDown" />
                            <button type="button" class="btn-action btn-blue" style="width:auto; padding: 0 28px;" @onclick="StartLiveTrackingAsync">
                                CANLI KONUMA BAĞLAN
                            </button>
                            @if (_isStreamRunning)
                            {
                                <button type="button" class="btn-action" style="width:auto; padding: 0 16px; background:#dc2626;" @onclick="() => StopLiveTracking(clearMessage: false)">
                                    DURDUR
                                </button>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(_liveMapFeedback))
                        {
                            <div class="alert-box @(_liveMapSuccess ? "alert-ok" : "alert-err")" style="margin-top:14px;">
                                @_liveMapFeedback
                            </div>
                        }
                    </div>

                    @if (_isMapVisible)
                    {
                        <div class="live-status-card" style="max-width: 800px; margin-bottom: 12px;">
                            <div class="status-indicator">
                                <span class="blink-dot"></span>
                                <strong>@_courierName</strong>
                            </div>
                            <div class="status-text">@_liveStepMessage</div>
                        </div>

                        <div id="cargoMapBox" style="width: 100%; max-width: 800px; height: 420px; border: 2px solid #1e293b; border-radius: 4px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);"></div>
                    }
                </div>
            }

        </main>
    </div>
</div>

<style>
    * {
        box-sizing: border-box;
    }

    body, html {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', sans-serif;
        background: #f1f5f9;
        color: #0f172a;
    }

    .app-wrapper {
        display: flex;
        height: 100vh;
        width: 100vw;
        overflow: hidden;
    }

    .sidebar {
        width: 255px;
        background: #0f172a;
        color: #94a3b8;
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        user-select: none;
    }

    .brand-header {
        background: #090e1a;
        padding: 20px 22px;
        border-bottom: 1px solid #1e293b;
    }

        .brand-header h1 {
            margin: 0;
            font-size: 22px;
            color: #38bdf8;
            letter-spacing: 0.5px;
        }

        .brand-header p {
            margin: 6px 0 0 0;
            font-size: 11.5px;
            color: #94a3b8;
            font-style: italic;
            line-height: 1.4;
        }

    .nav-list {
        display: flex;
        flex-direction: column;
        margin-top: 10px;
    }

    .nav-btn {
        background: transparent;
        border: none;
        border-left: 5px solid transparent;
        color: #94a3b8;
        padding: 17px 22px;
        text-align: left;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.15s;
    }

        .nav-btn:hover {
            background: #1e293b;
            color: #e2e8f0;
        }

        .nav-btn.active {
            background: #1e293b;
            color: #ffffff;
            border-left-color: #38bdf8;
        }

    .sidebar-footer {
        margin-top: auto;
        padding: 16px;
        text-align: center;
        font-size: 11px;
        color: #64748b;
        border-top: 1px solid #1e293b;
    }

    .main-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .top-header {
        height: 60px;
        background: #ffffff;
        border-bottom: 1px solid #cbd5e1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 26px;
        flex-shrink: 0;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .btn-back {
        background: #e2e8f0;
        color: #1e293b;
        border: none;
        padding: 7px 14px;
        font-weight: 700;
        font-size: 12.5px;
        border-radius: 4px;
        cursor: pointer;
    }

        .btn-back:disabled {
            opacity: 0.45;
            cursor: default;
        }

    .breadcrumb-text {
        font-weight: 700;
        font-size: 14px;
        color: #334155;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 24px;
        font-size: 13px;
        font-weight: 700;
    }

    .server-badge.online {
        color: #16a34a;
    }

    .server-badge.offline {
        color: #dc2626;
    }

    .live-clock {
        color: #475569;
    }

    .page-content {
        flex: 1;
        padding: 26px 30px;
        overflow-y: auto;
    }

    .page-title {
        margin: 0 0 6px 0;
        font-size: 24px;
        font-weight: 700;
        color: #0f172a;
    }

    .page-subtitle {
        margin: 0 0 22px 0;
        font-size: 14px;
        color: #64748b;
    }

    .summary-cards {
        display: grid;
        grid-template-columns: repeat(3, 295px);
        gap: 22px;
        margin-bottom: 28px;
    }

    .summary-card {
        padding: 22px;
        color: #ffffff;
        cursor: pointer;
        transition: transform 0.15s;
        user-select: none;
    }

        .summary-card:hover {
            transform: translateY(-3px);
        }

    .card-blue {
        background: #1e40af;
    }

    .card-green {
        background: #15803d;
    }

    .card-slate {
        background: #475569;
    }

    .sc-title {
        font-size: 12px;
        font-weight: 700;
    }

    .sc-count {
        font-size: 44px;
        font-weight: 800;
        margin: 12px 0 18px 0;
    }

    .sc-link {
        font-size: 11.5px;
        color: #e2e8f0;
    }

    .slogan-box {
