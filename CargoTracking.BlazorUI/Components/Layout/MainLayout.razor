@inherits LayoutComponentBase
@using CargoTracking.BlazorUI.Services
@implements IDisposable
@inject UiStateService UiState
@inject IJSRuntime JSRuntime

@*
    ANA ŞABLON (LAYOUT)
    Bütün sayfaların içinde gösterildiği ortak çerçeve: sol menü (Sidebar), üst bar
    (geri butonu, ekmek kırıntısı, sunucu durumu, saat, tema butonu) ve bildirim kutusu.
    Sayfanın kendi içeriği @Body yerine yerleşir.
    Ayrıca arka planda her 3 saniyede bir kargo listesini yeniler; menüdeki canlı rozet,
    "teslim edildi" bildirimleri ve sunucu durumu bu sayede güncel kalır.
*@

<div class="kp-app @(UiState.IsDarkMode ? "kp-dark" : "kp-light")">

    <!-- SAĞ ÜST BİLDİRİM KUTUSU -->
    <ToastHost />

    <!-- SOL KURUMSAL MENÜ -->
    <Sidebar />

    <!-- SAĞ ANA BÖLGE -->
    <div class="kp-main">
        <header class="kp-topbar no-print">
            <div class="kp-topbar-left">
                <button type="button" class="kp-btn-back" @onclick="GoBackInBrowserAsync">
                    ← Geri
                </button>
                <div class="kp-breadcrumb">@UiState.Breadcrumb</div>
            </div>

            <div class="kp-topbar-right">
                <div class="kp-status-pill @(UiState.ServerOnline ? "online" : "offline")">
                    <span class="kp-dot"></span>
                    @(UiState.ServerOnline ? "gRPC Sunucu Aktif" : "Sunucu Bağlantısı Yok")
                </div>

                <Clock Minimal="false" />

                <button type="button" class="kp-theme-btn" @onclick="() => UiState.ToggleThemeAsync(JSRuntime)">
                    @if (UiState.IsDarkMode)
                    {
                        <span>☀️ Gündüz Modu</span>
                    }
                    else
                    {
                        <span>🌙 Gece Modu</span>
                    }
                </button>
            </div>
        </header>

        <main class="kp-content">
            @Body
        </main>
    </div>
</div>

@code {
    private PeriodicTimer? _bgTimer;
    private CancellationTokenSource _cts = new();

    protected override void OnInitialized()
    {
        UiState.OnChange += HandleStateChanged;
        _ = RunBackgroundSyncLoopAsync();
    }

    private async Task RunBackgroundSyncLoopAsync()
    {
        // İlk açılışta hemen çek
        await InvokeAsync(async () => await UiState.RefreshCargosAsync());

        // Sonra her 3 saniyede bir arka planda sessizce senkronize et
        _bgTimer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await _bgTimer.WaitForNextTickAsync(_cts.Token))
            {
                await InvokeAsync(async () => await UiState.RefreshCargosAsync());
            }
        }
        catch (OperationCanceledException) { }
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    private async Task GoBackInBrowserAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("history.back");
        }
        catch { }
    }

    public void Dispose()
    {
        UiState.OnChange -= HandleStateChanged;
        _cts.Cancel();
        _bgTimer?.Dispose();
        _cts.Dispose();
    }
}