<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- PWA MANİFEST VE MOBİL TEMA -->
    <link rel="manifest" href="manifest.json" />
    <meta name="theme-color" content="#0f172a" />

    <!-- KURUMSAL INTER FONT AİLESİ -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CargoTracking.BlazorUI.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <!-- BÖLDÜĞÜMÜZ 3 CSS DOSYASINI BURAYA TANITIYORUZ -->
    <link rel="stylesheet" href="css/kp-variables.css" />
    <link rel="stylesheet" href="css/kp-layout.css" />
    <link rel="stylesheet" href="css/kp-components.css" />


    <!-- HARİTA GECE MODU FİLTRESİ (API KEY GEREKTİRMEZ, %100 ÜCRETSİZ OSM KULLANIR) -->
    <style>
        .kp-dark-tiles {
            filter: invert(100%) hue-rotate(180deg) brightness(95%) contrast(90%);
        }
        .leaflet-container {
            background: #0f172a !important;
        }
    </style>
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="@Assets["js/kp-map.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>