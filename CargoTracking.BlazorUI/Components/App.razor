<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["CargoTracking.BlazorUI.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    let cargoMap = null;
    let courierMarker = null;
    let routePolyline = null;

    window.initCargoTrackingMap = async (elementId, startLat, startLng, destLat, destLng, currentLat, currentLng) => {
        const container = document.getElementById(elementId);
        if (!container) return;

        if (cargoMap) {
            cargoMap.remove();
            cargoMap = null;
        }

        cargoMap = L.map(elementId).setView([currentLat, currentLng], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(cargoMap);

        // Çıkış Şubesi Pini
        L.marker([startLat, startLng]).addTo(cargoMap)
            .bindPopup("<b>Çıkış Transfer Şubesi</b>");

        // Teslimat Adresi Pini
        L.marker([destLat, destLng]).addTo(cargoMap)
            .bindPopup("<b>Teslimat Adresi</b>").openPopup();

        // Kurye Pini
        courierMarker = L.marker([currentLat, currentLng]).addTo(cargoMap)
            .bindPopup("<b>Kurye Dağıtımda</b>");

        // OSRM (En Kısa Yol / Yöneylem Motoru) ile gerçek sokak rotasını çiz
        try {
            const url = `https://router.project-osrm.org/route/v1/driving/${startLng},${startLat};${destLng},${destLat}?overview=full&geometries=geojson`;
            const response = await fetch(url);
            const data = await response.json();

            if (data.routes && data.routes.length > 0) {
                const coords = data.routes[0].geometry.coordinates.map(c => [c[1], c[0]]);
                routePolyline = L.polyline(coords, { color: '#1e40af', weight: 5 }).addTo(cargoMap);
                cargoMap.fitBounds(routePolyline.getBounds(), { padding: [40, 40] });
                return;
            }
        } catch (e) {
            console.warn("OSRM rota hatası, düz çizgiye dönülüyor:", e);
        }

        // İnternet/OSRM erişimi olmazsa yedek çizgi
        routePolyline = L.polyline([[startLat, startLng], [destLat, destLng]], { color: '#1e40af', weight: 4, dashArray: '6, 8' }).addTo(cargoMap);
        cargoMap.fitBounds(routePolyline.getBounds(), { padding: [40, 40] });
    };

    window.updateCourierLocationOnMap = (lat, lng) => {
        if (courierMarker && cargoMap) {
            courierMarker.setLatLng([lat, lng]);
        }
    };
</script>
<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
